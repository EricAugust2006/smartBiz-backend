# Database & Redis
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartbiz_db?schema=public"
REDIS_HOST="localhost"
REDIS_PORT=6379

# App Config
PORT=3000
JWT_SECRET="sua_chave_secreta_super_segura_jwt_smartbiz"
B2C_APP_URL="http://localhost:3000"
# B2B tokens expire after 24 hours (fixed by the API contract).

# Gemini Copilot
# Required for generative responses. Set a real key in the local .env without quotes.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# WhatsApp Service (Evolution API / Z-API)
WHATSAPP_API_URL="http://localhost:8080"
WHATSAPP_API_KEY="sua_chave_api_whatsapp"
