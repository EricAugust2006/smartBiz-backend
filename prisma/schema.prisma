generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  STAFF
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  BLACK
}

enum MissionStatus {
  ACTIVE
  EXPIRED
  INACTIVE
}

enum GoalType {
  VISITS
  AMOUNT
}

enum CustomerMissionStatus {
  PENDING
  COMPLETED
}

model Tenant {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  plan           String   @default("PRO") // STARTER, PRO, ENTERPRISE
  whatsappNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users        User[]
  customers    Customer[]
  products     Product[]
  missions     Mission[]
  transactions Transaction[]
  pointsLedger PointsLedger[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OWNER)
  createdAt    DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordedSales Transaction[]

  @@unique([tenantId, id])
  @@map("users")
}

model Customer {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  phone       String
  cpf         String?
  tier        Tier     @default(BRONZE)
  isVipMember Boolean  @default(false)
  points      Int      @default(0)
  createdAt   DateTime @default(now())

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  missions     CustomerMission[]
  transactions Transaction[]
  pointsLedger PointsLedger[]

  @@unique([tenantId, phone])
  @@unique([tenantId, cpf])
  @@unique([tenantId, id])
  @@map("customers")
}

model Product {
  id             String    @id @default(uuid())
  tenantId       String
  name           String
  category       String
  quantity       Int
  minQuantity    Int       @default(5)
  costPrice      Float
  sellPrice      Float
  expirationDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleItems TransactionItem[]

  @@unique([tenantId, id])
  @@map("products")
}

model Mission {
  id          String        @id @default(uuid())
  tenantId    String
  name        String        @map("title")
  description String?
  goalType    GoalType
  targetValue Decimal       @db.Decimal(12, 2)
  reward      String
  status      MissionStatus @default(ACTIVE)
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers CustomerMission[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id])
  @@map("missions")
}

model CustomerMission {
  id          String                @id @default(uuid())
  tenantId    String
  customerId  String
  missionId   String
  status      CustomerMissionStatus @default(PENDING)
  completedAt DateTime?
  visits      Int                   @default(0)
  lastVisitAt DateTime?

  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  mission  Mission  @relation(fields: [tenantId, missionId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, customerId, missionId])
  @@index([tenantId, missionId])
  @@map("customer_missions")
}

model Transaction {
  id             String   @id @default(uuid())
  tenantId       String
  customerId     String?
  amount         Decimal  @db.Decimal(12, 2)
  type           String // SALE, SUBSCRIPTION, REFUND
  createdAt      DateTime @default(now())
  createdById    String?
  idempotencyKey String?
  requestHash    String?

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?         @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy    User?             @relation(fields: [tenantId, createdById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  items        TransactionItem[]
  events       OutboxEvent[]
  pointsLedger PointsLedger?

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId, type, createdAt, id])
  @@map("transactions")
}

model TransactionItem {
  id            String  @id @default(uuid())
  tenantId      String
  transactionId String
  productId     String
  name          String
  quantity      Int
  unitPrice     Decimal @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [tenantId, transactionId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  product     Product     @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, transactionId, productId])
  @@index([tenantId, productId])
  @@map("transaction_items")
}

model OutboxEvent {
  id            String    @id @default(uuid())
  tenantId      String
  transactionId String
  type          String
  payload       Json
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?

  transaction  Transaction   @relation(fields: [tenantId, transactionId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  pointsLedger PointsLedger?

  @@unique([tenantId, id])
  @@unique([tenantId, transactionId, type])
  @@index([tenantId, processedAt, createdAt])
  @@index([tenantId, processedAt, nextAttemptAt, createdAt])
  @@map("outbox_events")
}

model PointsLedger {
  id            String   @id @default(uuid())
  tenantId      String
  customerId    String
  transactionId String
  eventId       String
  points        Int
  balanceAfter  Int
  visitCounted  Boolean
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer    Customer    @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  transaction Transaction @relation(fields: [tenantId, transactionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  event       OutboxEvent @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, transactionId])
  @@unique([tenantId, eventId])
  @@index([tenantId, customerId, createdAt])
  @@map("points_ledger")
}
