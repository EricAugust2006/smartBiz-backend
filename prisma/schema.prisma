generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  STAFF
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  BLACK
}

enum MissionStatus {
  ACTIVE
  EXPIRED
  INACTIVE
}

enum CustomerMissionStatus {
  PENDING
  COMPLETED
}

model Tenant {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  plan           String         @default("PRO") // STARTER, PRO, ENTERPRISE
  whatsappNumber String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  users          User[]
  customers      Customer[]
  products       Product[]
  missions       Mission[]
  transactions   Transaction[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OWNER)
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Customer {
  id          String            @id @default(uuid())
  tenantId    String
  name        String
  phone       String
  tier        Tier              @default(BRONZE)
  isVipMember Boolean           @default(false)
  points      Int               @default(0)
  createdAt   DateTime          @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  missions    CustomerMission[]
  transactions Transaction[]

  @@unique([tenantId, phone])
  @@map("customers")
}

model Product {
  id             String    @id @default(uuid())
  tenantId       String
  name           String
  category       String
  quantity       Int
  minQuantity    Int       @default(5)
  costPrice      Float
  sellPrice      Float
  expirationDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("products")
}

model Mission {
  id          String            @id @default(uuid())
  tenantId    String
  title       String
  description String
  reward      String
  status      MissionStatus     @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers   CustomerMission[]

  @@map("missions")
}

model CustomerMission {
  id          String                @id @default(uuid())
  customerId  String
  missionId   String
  status      CustomerMissionStatus @default(PENDING)
  completedAt DateTime?

  customer    Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  mission     Mission               @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("customer_missions")
}

model Transaction {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String?
  amount     Float
  type       String   // SALE, SUBSCRIPTION, REFUND
  createdAt  DateTime @default(now())

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("transactions")
}
